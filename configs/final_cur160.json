{
  "architecture": "qwen_distill_v12",
  "base_model": "Qwen2.5-Coder-0.5B",
  "train_samples": 70000,
  "validation": {
    "type": "StratifiedGroupKFold",
    "n_splits": 5,
    "seed": 42,
    "group_rule": "sample id before -step_"
  },
  "training": {
    "full_max_updates": 3500,
    "head_lr": 0.0004,
    "lora_lr": 2e-05
  },
